# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/vehicle_rental
# For MongoDB Atlas use something like:
# MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/vehicle_rental

# JWT
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Client (for CORS)
CLIENT_URL=http://localhost:5173

# Optional: Stripe payment integration
STRIPE_SECRET_KEY=

# Email notifications (sent when a new booking is created)
# For Gmail: use smtp.gmail.com, port 587, and a 16-character App Password
# (not your normal password) generated at https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_char_app_password
EMAIL_FROM="RoveOn <your_email@gmail.com>"

# The address that should receive new-booking notifications (usually your own email)
ADMIN_EMAIL=your_email@gmail.com

# Image uploads via Cloudinary (recommended for production — most hosts wipe
# local disk storage on every redeploy). Leave blank to use local disk storage
# for development instead. Get these from your Cloudinary dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
